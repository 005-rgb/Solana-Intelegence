generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RadarState {
  id               Int       @id @default(1)
  mode             String    @default("live")
  provider         String
  lastScan         DateTime?
  nextScanAt       DateTime?
  scanRunning      Boolean   @default(false)
  watchlistHistory Json
  system           Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Token {
  id              Int              @id @default(autoincrement())
  mint            String           @unique
  symbol          String
  name            String
  price           String
  marketCap       Float?
  liquidity       Float?
  radar           Int?
  opportunity     Int?
  smartMoney      Int?
  momentum        Int?
  hype            Int?
  risk            Int?
  confidence      Int?
  priceChange     String
  whaleFlow       String
  holderGrowth    String
  status          String
  age             String
  rationale       String
  riskLabel       String
  dataQuality     Int?
  potential       String
  providerUrl     String?
  details         Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  watchlistEntry  WatchlistEntry?
  watchlistEvents WatchlistEvent[]
  positions       PaperPosition[]
  trades          PaperTrade[]

  @@index([radar])
  @@index([risk])
  @@index([status])
  @@index([updatedAt])
}

model WatchlistEntry {
  id        Int      @id @default(autoincrement())
  tokenId   Int      @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
}

model WatchlistEvent {
  id        Int      @id @default(autoincrement())
  tokenId   Int
  action    String
  createdAt DateTime @default(now())
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, createdAt])
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String
  token     String
  text      String
  tone      String
  timeLabel String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Pattern {
  id        Int      @id @default(autoincrement())
  patternId String   @unique
  name      String
  detail    String
  match     Int
  sample    Int
  outcome   String
  tone      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaperAccount {
  id        Int             @id @default(1)
  starting  Float
  cash      Float
  realized  Float
  fees      Float
  trades    Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  positions PaperPosition[]
  history   PaperTrade[]
}

model PaperPosition {
  id        Int          @id @default(autoincrement())
  accountId Int
  tokenId   Int
  invested  Float
  quantity  Float
  entry     Float
  peakPnl   Float
  openedAt  DateTime
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token     Token        @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([accountId, tokenId])
  @@index([openedAt])
}

model PaperTrade {
  id        Int          @id @default(autoincrement())
  accountId Int
  tokenId   Int?
  symbol    String
  side      String
  amount    Float
  price     Float
  fee       Float        @default(0)
  score     Int?
  time      DateTime     @default(now())
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token     Token?       @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([accountId, time])
}

model ScanRun {
  id                           String             @id @default(cuid())
  manual                       Boolean            @default(false)
  status                       String
  startedAt                    DateTime
  finishedAt                   DateTime?
  durationMs                   Int?
  tokensScanned                Int                @default(0)
  transactionsProcessed        Int                @default(0)
  errorCount                   Int                @default(0)
  provider                     String
  recordsChecked               Int                @default(0)
  acceptedCount                Int                @default(0)
  rejectedCount                Int                @default(0)
  unresolvedCount              Int                @default(0)
  rejectionReasons             Json?
  filterConfig                 Json?
  providerAgeMs                Int?
  providerRecords              Int                @default(0)
  pairRequests                 Int                @default(0)
  pairFailures                 Int                @default(0)
  rpcStatus                    String?
  qualityStatus                String?
  discoveryUniverseSize        Int                @default(0)
  providerRecordsWithPair      Int                @default(0)
  providerRecordsWithPrice     Int                @default(0)
  providerRecordsWithLiquidity Int                @default(0)
  securityVerified             Int                @default(0)
  securityUnknown              Int                @default(0)
  securityRejected             Int                @default(0)
  liquidityRejected            Int                @default(0)
  momentumRejected             Int                @default(0)
  ctoRejected                  Int                @default(0)
  tokensPersisted              Int                @default(0)
  providerFreshnessMs          Int?
  rpcFreshnessMs               Int?
  rpcCommitment                String?
  timedOut                     Boolean            @default(false)
  timeoutReason                String?
  decisionVersion              String             @default("baseline-v1")
  correlationId                String?
  sourceMetrics                Json?
  tokenObservations            TokenObservation[]

  @@index([startedAt])
  @@index([status])
}

model TokenObservation {
  id                 String    @id @default(cuid())
  scanRunId          String?
  mint               String
  pairAddress        String?
  chainId            String
  dexId              String?
  baseToken          Json?
  quoteToken         Json?
  observedAt         DateTime
  providerUpdatedAt  DateTime?
  pairCreatedAt      DateTime?
  priceUsd           Float?
  marketCap          Float?
  fdv                Float?
  liquidityUsd       Float?
  volume             Json
  transactions       Json
  makers             Json
  priceChange        Json
  boostAmount        Float?
  ctoFlag            Boolean?
  source             String
  sourceEndpoint     String?
  sourceRequestId    String?
  sourceResponseHash String?
  freshnessMs        Int?
  dataQuality        String
  qualityReasons     Json
  rawPayload         Json
  createdAt          DateTime  @default(now())
  scanRun            ScanRun?  @relation(fields: [scanRunId], references: [id], onDelete: SetNull)

  @@index([mint, observedAt])
  @@index([pairAddress, observedAt])
  @@index([scanRunId])
}

model WhaleActivityPoint {
  id          Int      @id @default(autoincrement())
  recordedAt  DateTime
  buyVolume   Float?
  sellVolume  Float?
  netFlow     Float?
  totalVolume Float?
  source      String
  dataQuality Int?
  createdAt   DateTime @default(now())

  @@index([source, recordedAt])
}
